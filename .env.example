# Copy this file to `.env` and fill it in. `.env` is listed in .gitignore, so it is never committed.

# ---------------------------------------------------------------
# PostgreSQL  (Aiven console -> your PostgreSQL service -> "Service URI")
# ---------------------------------------------------------------
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR-PG-HOST.aivencloud.com:12345/defaultdb?sslmode=require
# Keep this small on the free tier (it has a low connection limit)
DB_POOL_MAX=8

# ---------------------------------------------------------------
# Apache Kafka  (Aiven console -> your Kafka service -> "Connection information")
# Pick ONE authentication style, matching what your Aiven service uses.
# ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=YOUR-KAFKA-HOST.aivencloud.com:12345

# Style A: client certificate (Aiven default). Download ca.pem, service.cert and service.key into ./certs/
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_FILE=certs/ca.pem
KAFKA_SSL_CERT_FILE=certs/service.cert
KAFKA_SSL_KEY_FILE=certs/service.key

# Style B: SASL username/password (use the SASL port from the console). Uncomment these and
# set KAFKA_SECURITY_PROTOCOL=SASL_SSL above.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=YOUR_PASSWORD

KAFKA_TOPIC_ORDERS=omnistore.orders
KAFKA_TOPIC_INVENTORY=omnistore.inventory
KAFKA_PARTITIONS=2

# ---------------------------------------------------------------
# OpenSearch  (Aiven console -> your OpenSearch service -> "Service URI")
# ---------------------------------------------------------------
OPENSEARCH_URL=https://avnadmin:YOUR_PASSWORD@YOUR-OS-HOST.aivencloud.com:12345
OPENSEARCH_INDEX=omnistore-listings

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Enables the "Demo tools" panel (race test, restock). Turn off for anything public.
DEMO_MODE=true

# ---------------------------------------------------------------
# Optional: run everything locally instead of on Aiven (docker compose up -d), then use:
#   DATABASE_URL=postgresql://omni:omni@localhost:5432/omnistore
#   KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#   KAFKA_SECURITY_PROTOCOL=PLAINTEXT
#   OPENSEARCH_URL=http://localhost:9200
# ---------------------------------------------------------------
